<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. The Background Circle -->
    <!-- We make this slightly smaller than the 108dp limit -->
    <item
        android:width="100dp"
        android:height="100dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#6C63FF" />
        </shape>
    </item>

    <!-- 2. Your Logo -->
    <!-- Industry Standard: The logo should be exactly 72dp or smaller
         to stay inside the circle mask of Android 12+ -->
    <item
        android:id="@+id/splash_logo_item"
        android:drawable="@drawable/payplitlogo"
        android:width="60dp"
        android:height="60dp"

        android:gravity="center" />

</layer-list>